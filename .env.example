# -----------------------------------------------------------------------------
# MONOREPO ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# Environment Mode
NODE_ENV=development

# Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Backend Configuration
API_PORT=4000
API_GLOBAL_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Relational Data: Users, Roles, Settings, Refresh Tokens)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monorepo_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monorepo_db?schema=public

# MongoDB (Document Data: Audit Logs, Telemetry, Metadata)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=monorepo_db
MONGO_PORT=27017
MONGODB_URI=mongodb://root:password@localhost:27017/monorepo_db?authSource=admin

# Valkey / In-Memory Cache & Rate Limiting
VALKEY_PORT=6379
VALKEY_HOST=localhost
VALKEY_PASSWORD=

# Authentication Secrets
# Generate secure 256-bit keys using: openssl rand -base64 32
JWT_ACCESS_SECRET=your_jwt_access_secret_super_secure_key_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_super_secure_key_67890
JWT_REFRESH_EXPIRES_IN=7d

