{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@monorepo/shared-types": ["packages/shared-types/src/index.ts"],
      "@monorepo/shared-types/*": ["packages/shared-types/src/*"],
      "@monorepo/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@monorepo/shared-utils/*": ["packages/shared-utils/src/*"],
      "@monorepo/validation": ["packages/validation/src/index.ts"],
      "@monorepo/validation/*": ["packages/validation/src/*"],
      "@monorepo/ui": ["packages/ui/src/index.ts"],
      "@monorepo/ui/*": ["packages/ui/src/*"],
      "@monorepo/config": ["packages/config/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "coverage"]
}

